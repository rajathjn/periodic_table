[
  {
    "name": "Initial JS (excluding lazy chunks)",
    "path": "dist/assets/index-*.js",
    "limit": "100 KB",
    "gzip": true
  },
  {
    "name": "elements-data chunk",
    "path": "dist/assets/elements-data-*.js",
    "limit": "120 KB",
    "gzip": true
  },
  {
    "name": "Three.js / GLBViewer chunk",
    "path": "dist/assets/GLBViewer-*.js",
    "limit": "400 KB",
    "gzip": true
  },
  {
    "name": "All CSS",
    "path": "dist/assets/*.css",
    "limit": "20 KB",
    "gzip": true
  }
]
